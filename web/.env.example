# Copy to .env.production on the server. Set these BEFORE `next build`:
# static pages and link-preview cards read them at build time.

# Postgres connection for the archive
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/canine_pedigree_archive

# Public address of the site (no trailing slash). Used for share cards, sitemap and canonical links.
SITE_URL=https://example.org

# Where "Report an error" links send corrections. Leave empty to hide the address.
CONTACT_EMAIL=
